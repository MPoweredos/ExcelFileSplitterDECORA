<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ExcelFileSplitter</RootNamespace>
    <AssemblyName>ExcelFileSplitter</AssemblyName>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="ExcelFileSplitter.Core\ExcelFileSplitter.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="ExcelFileSplitter.Core/**" />
    <None Remove="ExcelFileSplitter.Core/**" />
    <Compile Remove="ExcelFileSplitter.Ui/**" />
    <None Remove="ExcelFileSplitter.Ui/**" />
    <Compile Remove="ExcelFileSplitter.Tests/**" />
    <None Remove="ExcelFileSplitter.Tests/**" />
  </ItemGroup>

</Project>
