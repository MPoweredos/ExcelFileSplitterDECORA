<UserControl x:Class="ExcelFileSplitter.Ui.Wizard.PivotStep3Prepare"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kreator="clr-namespace:ExcelFileSplitter.Ui.Wizard">

    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource NaglowekKroku}" Text="Przygotowanie skoroszytu" />
            <TextBlock Style="{StaticResource OpisKroku}"
                       Text="Ten etap kopiuje raport i wstrzykuje w jego kod M tabele parametrów oraz filtry z sekcji Queries. Oryginał zostaje nietknięty - dalsze etapy pracują wyłącznie na kopii. Trzeba go powtórzyć po każdej zmianie zapytań w raporcie albo w ustawieniach." />

            <Border Background="#F3F3F3" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock x:Name="OpisZrodla" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <TextBlock x:Name="OpisRoboczego" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button x:Name="PrzyciskPrzygotuj" Content="Przygotuj skoroszyt" Click="Przygotuj_Click"
                        MinWidth="180" Margin="0,0,12,0" />
                <TextBlock x:Name="Wynik" VerticalAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold" />
            </StackPanel>

            <TextBlock Text="Przebieg:" FontWeight="SemiBold" Margin="0,0,0,4" />
        </StackPanel>

        <kreator:LogView x:Name="ListaLogu" />
    </DockPanel>
</UserControl>
