<UserControl x:Class="ExcelFileSplitter.Ui.Wizard.Step1File"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>
        <TextBlock Style="{StaticResource NaglowekKroku}" Text="Plik do podziału" />
        <TextBlock Style="{StaticResource OpisKroku}"
                   Text="Wskaż zwykły plik Excela z danymi wszystkich odbiorców oraz folder, w którym mają powstać pliki dla poszczególnych odbiorców. Oryginał nie jest zmieniany - każdy plik wynikowy powstaje z jego kopii." />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Plik źródłowy" VerticalAlignment="Center" Margin="0,0,12,10" />
            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="PoleZrodlo" Padding="4,3" Margin="0,0,0,10" />
            <Button    Grid.Row="0" Grid.Column="2" Content="Wybierz..." Click="Zrodlo_Click" Margin="8,0,0,10" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Folder wynikowy" VerticalAlignment="Center" Margin="0,0,12,10" />
            <TextBox   Grid.Row="1" Grid.Column="1" x:Name="PoleWynik" Padding="4,3" Margin="0,0,0,10" />
            <Button    Grid.Row="1" Grid.Column="2" Content="Wybierz..." Click="Wynik_Click" Margin="8,0,0,10" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Nazwa pliku" VerticalAlignment="Center" Margin="0,0,12,10" />
            <TextBox   Grid.Row="2" Grid.Column="1" x:Name="PoleSzablon" Padding="4,3" Margin="0,0,0,10" />
        </Grid>

        <TextBlock Foreground="#555555" TextWrapping="Wrap"
                   Text="W nazwie pliku {value} zostanie zamienione na nazwę odbiorcy - bez tego każdy kolejny plik nadpisywałby poprzedni." />
    </StackPanel>
</UserControl>
