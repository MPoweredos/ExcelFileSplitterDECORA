<UserControl x:Class="ExcelFileSplitter.Ui.Wizard.Step3Column"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kreator="clr-namespace:ExcelFileSplitter.Ui.Wizard">

    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource NaglowekKroku}" Text="Kolumny podziału" />
            <TextBlock Style="{StaticResource OpisKroku}"
                       Text="Po czym rozdzielić dane. Przy jednej kolumnie plik powstaje dla każdej jej wartości. Przy dwóch lub trzech - dla każdej występującej w danych KOMBINACJI wartości, np. osobny plik na każdą parę region-handlowiec." />

            <kreator:PassBar x:Name="PasekPodzialow" />

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Kolumna" VerticalAlignment="Center" Margin="0,0,8,6" />
                <ComboBox   Grid.Row="0" Grid.Column="1" x:Name="ListaKolumn1" Width="280" Padding="4,3" Margin="0,0,0,6"
                            SelectionChanged="Kolumna_Changed" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="oraz" VerticalAlignment="Center" Margin="0,0,8,6" />
                <ComboBox   Grid.Row="1" Grid.Column="1" x:Name="ListaKolumn2" Width="280" Padding="4,3" Margin="0,0,0,6"
                            SelectionChanged="Kolumna_Changed" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="oraz" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox   Grid.Row="2" Grid.Column="1" x:Name="ListaKolumn3" Width="280" Padding="4,3"
                            SelectionChanged="Kolumna_Changed" />

                <TextBlock Grid.Row="2" Grid.Column="2" x:Name="Podsumowanie" VerticalAlignment="Center"
                           Margin="12,0,0,0" Foreground="#555555" TextWrapping="Wrap" />
            </Grid>

            <TextBlock x:Name="NaglowekListy" Text="Kombinacje w danych:" FontWeight="SemiBold" Margin="0,0,0,4" />
        </StackPanel>

        <ListView x:Name="ListaWartosci">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Kombinacja" Width="380" DisplayMemberBinding="{Binding Display}" />
                    <GridViewColumn Header="Wierszy" Width="110" DisplayMemberBinding="{Binding RowCountLabel}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
