<UserControl x:Class="ExcelFileSplitter.Ui.Wizard.PivotStep1Files"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>
        <TextBlock Style="{StaticResource NaglowekKroku}" Text="Plik i foldery" />
        <TextBlock Style="{StaticResource OpisKroku}"
                   Text="Raport z Modelem danych, folder na pliki odbiorców i folder na cache. Oryginał nie jest modyfikowany - przygotowanie tworzy obok niego osobny skoroszyt roboczy." />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Plik źródłowy" VerticalAlignment="Center" Margin="0,0,12,10" />
            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="PoleZrodlo" Padding="4,3" Margin="0,0,0,10"
                       TextChanged="Zrodlo_Changed" />
            <Button    Grid.Row="0" Grid.Column="2" Content="Wybierz..." Click="Zrodlo_Click" Margin="8,0,0,10" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Folder wynikowy" VerticalAlignment="Center" Margin="0,0,12,10" />
            <TextBox   Grid.Row="1" Grid.Column="1" x:Name="PoleWynik" Padding="4,3" Margin="0,0,0,10" />
            <Button    Grid.Row="1" Grid.Column="2" Content="Wybierz..." Click="Wynik_Click" Margin="8,0,0,10" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Folder cache" VerticalAlignment="Center" Margin="0,0,12,10" />
            <TextBox   Grid.Row="2" Grid.Column="1" x:Name="PoleCache" Padding="4,3" Margin="0,0,0,10" />
            <Button    Grid.Row="2" Grid.Column="2" Content="Wybierz..." Click="Cache_Click" Margin="8,0,0,10" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Nazwa pliku" VerticalAlignment="Center" Margin="0,0,12,10" />
            <TextBox   Grid.Row="3" Grid.Column="1" x:Name="PoleSzablon" Padding="4,3" Margin="0,0,0,10" />
        </Grid>

        <TextBlock Foreground="#555555" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="W nazwie pliku {value} zostanie zamienione na nazwę odbiorcy - bez tego każdy kolejny plik nadpisywałby poprzedni. Folder cache może być pusty, jeśli nie będziesz korzystać z etapu 1." />

        <Border Background="#F3F3F3" Padding="12">
            <StackPanel>
                <TextBlock Text="Skoroszyt roboczy, który powstanie w kroku przygotowania:" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock x:Name="SciezkaRobocza" TextWrapping="Wrap" Foreground="#555555" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
