<UserControl x:Class="ExcelFileSplitter.Ui.Wizard.PassBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border x:Name="Ramka" Background="#F4F6F8" BorderBrush="#DDDDDD" BorderThickness="1"
            Padding="10,8" Margin="0,0,0,12">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="Etykieta" Text="Podział" VerticalAlignment="Center"
                           FontWeight="SemiBold" Margin="0,0,8,0" />
                <ComboBox x:Name="Lista" Width="200" Padding="4,3" DisplayMemberPath="Label"
                          SelectionChanged="Lista_Changed" />

                <TextBlock Text="Nazwa" VerticalAlignment="Center" Margin="16,0,8,0" />
                <TextBox x:Name="PoleNazwa" Width="170" Padding="4,3" TextChanged="Nazwa_Changed"
                         ToolTip="Trafia do nazwy pliku w miejsce znacznika {podzial} - po niej poznasz, z którego podziału plik pochodzi." />

                <Button x:Name="PrzyciskDodaj" Content="Dodaj podział" Click="Dodaj_Click"
                        Margin="16,0,8,0" MinWidth="110"
                        ToolTip="Tworzy DRUGI, niezależny podział tego samego pliku - np. po obsłudze klienta obok podziału po menadżerze. Pliki z obu powstają w jednym przebiegu i się sumują." />
                <Button x:Name="PrzyciskUsun" Content="Usuń ten podział" Click="Usun_Click" MinWidth="120" />
            </StackPanel>
            <TextBlock x:Name="Opis" Foreground="#555555" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
    </Border>
</UserControl>
