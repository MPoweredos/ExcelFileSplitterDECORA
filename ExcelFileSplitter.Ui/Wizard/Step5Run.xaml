<UserControl x:Class="ExcelFileSplitter.Ui.Wizard.Step5Run"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kreator="clr-namespace:ExcelFileSplitter.Ui.Wizard">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource NaglowekKroku}" Text="Podsumowanie i podział" />
            <TextBlock Style="{StaticResource OpisKroku}"
                       Text="Sprawdź, co powstanie. Każdy plik po zapisaniu jest otwierany ponownie i sprawdzany - jeśli znajdziemy w nim cokolwiek obcego, dostanie w nazwie _NIE_WYSYŁAĆ." />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock x:Name="StanGotowosci" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4" />
            <ScrollViewer x:Name="RamkaProblemow" MaxHeight="110" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <ItemsControl x:Name="ListaProblemow">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{Binding Color}" Margin="0,0,0,3" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock DockPanel.Dock="Top" x:Name="NaglowekPlanu" FontWeight="SemiBold" Margin="0,0,0,4" Text="Pliki do utworzenia" />

                <TextBlock DockPanel.Dock="Top" x:Name="StarePliki" Visibility="Collapsed"
                           Foreground="#8A5300" TextWrapping="Wrap" Margin="0,0,0,8" />
                <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <TextBlock x:Name="LicznikWyboru" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Zaznacz wszystkie" Click="ZaznaczWszystkie_Click" />
                        <Button Content="Odznacz te, które już są" Click="OdznaczIstniejace_Click" />
                    </StackPanel>
                </DockPanel>

                <ListView x:Name="ListaPlanu">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="34">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Checked="Wybor_Changed" Unchecked="Wybor_Changed" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Plik" Width="200" DisplayMemberBinding="{Binding File}" />
                            <GridViewColumn Header="Na dysku" Width="110" DisplayMemberBinding="{Binding OnDisk}" />
                            <GridViewColumn x:Name="KolumnaPodzialu" Header="Z podziału" Width="0" DisplayMemberBinding="{Binding Pass}" />
                            <GridViewColumn Header="Czyje dane" Width="150" DisplayMemberBinding="{Binding Values}" />
                            <GridViewColumn Header="Arkusze" Width="190" DisplayMemberBinding="{Binding Sheets}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>

            <DockPanel Grid.Column="1">
                <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,4" Text="Przebieg" />
                <kreator:LogView x:Name="ListaLogu" />
            </DockPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="Wynik" VerticalAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="PrzyciskPrzerwij" Content="Przerwij" Click="Przerwij_Click" IsEnabled="False" />
                <Button x:Name="PrzyciskStart" Content="Rozpocznij podział" Click="Start_Click" MinWidth="150" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
